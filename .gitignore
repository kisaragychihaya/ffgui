# 依赖与构建产物
node_modules/
out/
/native/ffgui-disc/target/
/bin/disc/
# TTS 引擎（tts-server）构建产物：由 native/qwentts.cpp 子模块编译，见 bin/README.md
/bin/tts/
# 内置 aria2c（仅 Windows x64，模型下载断点续传用）：CI 从 aria2 官方 Release 下载，见 bin/README.md
/bin/aria2/

# 内置 ffmpeg 二进制（体积过大不进仓库，请按 bin/README.md 自行下载放置）
/bin/ffmpeg.exe
/bin/ffprobe.exe
# macOS 自建构建（tar.gz 解压出的 bin/ 与 lib/ 原样放入本目录）
/bin/bin/
/bin/lib/

# 手工测试用的示例媒体文件
test_media/

# 用户缺陷报告（第三方提交的原始反馈与修复包，不进入仓库）
bug_report/

# 临时文件
.tmp-*
*.log

# NSISBI 编译器目录：二进制由 scripts/build-installer.cjs 从 Release 资源下载解压，不入库
tools/nsisbi/*
!tools/nsisbi/README.md

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
